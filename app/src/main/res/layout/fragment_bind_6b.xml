<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bind_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bind_goods"
        android:textAlignment="center"
        android:textSize="@dimen/text_size_18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_label"
            android:textSize="@dimen/text_size_16" />

        <Spinner
            android:id="@+id/bind_tid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bind_goods"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/bind_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <Button
        android:id="@+id/bind_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textAllCaps="false"
        android:text="@string/bind_btn" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bind_item_epc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/layer"
            android:layout_weight="2"
            android:textSize="@dimen/text_size_16"
            android:text="TID"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/bind_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/layer"
            android:textSize="@dimen/text_size_16"
            android:layout_weight="1"
            android:text="@string/goods_table_title"
            android:textAlignment="center" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bind_listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <View
        android:layout_width="match_parent"
        android:background="@color/color2"
        android:layout_height="1px"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/bind_clean"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/clear_bind"
            android:textAllCaps="false"
            android:layout_height="wrap_content"/>


    </LinearLayout>

</LinearLayout>