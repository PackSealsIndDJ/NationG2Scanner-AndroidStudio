<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_label"
            android:textSize="@dimen/text_size_16" />

        <Spinner
            android:id="@+id/write_epc_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center" />

    </LinearLayout>


    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/color2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/write_area"
            android:textSize="@dimen/text_size_16" />

        <Spinner
            android:id="@+id/write_area_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/write_area_gb"
            android:textAlignment="center" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/write_address"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/write_start_editText"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:entries="@array/write_area"
            android:text="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(word)"
            android:textSize="@dimen/text_size_16" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_pwd"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/write_accessPwd_editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/write_area"
            android:text="00000000" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/safe_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/safe_pwd"
            android:textSize="@dimen/text_size_16" />

        <Spinner
            android:id="@+id/write_safe_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/write_safe_gb"
            android:textAlignment="center" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/write_content"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/write_content_editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/write_area"
            android:text="12345678" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>

    <Button
        android:id="@+id/write_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/write_card_btn"
        android:textAllCaps="false" />


    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/color2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_area"
            android:textSize="@dimen/text_size_16" />

        <Spinner
            android:id="@+id/lock_area_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/lock_area_gb"
            android:textAlignment="center" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_type"
            android:textSize="@dimen/text_size_16" />

        <Spinner
            android:id="@+id/lock_type_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/lock_type_gjb"
            android:textAlignment="center" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/access_pwd"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/lock_pwd_editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/write_area"
            android:text="00000000" />

    </LinearLayout>

    <Button
        android:id="@+id/lock_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/lock_btn"
        android:textAllCaps="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/color2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kill_pwd"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/destroy_pwd_editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/write_area"
            android:text="00000000" />

    </LinearLayout>

    <Button
        android:id="@+id/destroy_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/kill_btn"
        android:textAllCaps="false" />


</LinearLayout>